#!/bin/bash
# pre-commit hook: block commits containing potential secrets
# Install: cp hooks/pre-commit-no-secrets .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

echo "🔍 Scanning staged files for secrets..."

# Patterns that indicate real secrets (not placeholders)
PATTERNS=(
    'sk-[a-zA-Z0-9]{20,}'          # OpenAI API keys
    'sk-ant-[a-zA-Z0-9]{20,}'      # Anthropic API keys
    'AIzaSy[a-zA-Z0-9_-]{33}'      # Google API keys
    'ghp_[a-zA-Z0-9]{36}'          # GitHub PATs
    'gho_[a-zA-Z0-9]{36}'          # GitHub OAuth tokens
    'glpat-[a-zA-Z0-9_-]{20,}'     # GitLab PATs
    'AKIA[0-9A-Z]{16}'             # AWS access keys
    'ya29\.[a-zA-Z0-9_-]{50,}'     # Google OAuth tokens
)

# Files to skip (known safe patterns)
SKIP_PATTERNS='\.svg$|\.png$|\.jpg$|\.gif$|\.woff|\.ttf'

FOUND=0
for pattern in "${PATTERNS[@]}"; do
    # Search only staged (cached) file content, skip binaries
    MATCHES=$(git diff --cached --diff-filter=ACMR -U0 -- . \
        | grep -E "^\+" \
        | grep -v "^+++" \
        | grep -E "$pattern" \
        | grep -vi 'example\|placeholder\|your-.*-key\|sk-\.\.\.\|sk-ant-\.\.\.\|xxx\|REDACTED\|TODO\|fixme' \
        || true)

    if [ -n "$MATCHES" ]; then
        echo ""
        echo "❌ BLOCKED: Potential secret matching pattern: $pattern"
        echo "$MATCHES" | head -5
        FOUND=1
    fi
done

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "🚫 Commit blocked. Remove secrets before committing."
    echo "   If this is a false positive, use: git commit --no-verify"
    exit 1
fi

echo "✅ No secrets detected in staged changes."
